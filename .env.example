# Öffentliche Basis-URL (für Canonical, Sitemap, Open Graph). Domain vor Launch bestätigen.
NEXT_PUBLIC_SITE_URL=https://studio.nimbaland.example

# Unveröffentlichte Projekt-Entwürfe anzeigen (im Dev-Modus automatisch an).
NEXT_PUBLIC_SHOW_DRAFTS=false

# Suchmaschinen erst nach Launch zulassen.
SITE_INDEXABLE=false

# Kontaktformular: Ziel-Endpunkt, der JSON per POST annimmt (z. B. Formspree, Make, eigener Server).
# Ohne diesen Wert meldet das Formular ehrlich, dass es noch nicht verbunden ist.
CONTACT_WEBHOOK_URL=

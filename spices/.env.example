# Öffentliche Basis-URL (Canonical, Sitemap, Open Graph). Domain vor Launch bestätigen.
NEXT_PUBLIC_SITE_URL=https://nimbaland-spices.vercel.app

# Sanity (kostenloser Tarif). Projekt-ID und Dataset sind nicht geheim.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Lese-Token NUR auf dem Server (Vercel → Environment Variables). Nie mit NEXT_PUBLIC_ beginnen.
# In Sanity: Manage → API → Tokens → „Viewer“. Nötig, weil das Dataset privat ist.
SANITY_API_READ_TOKEN=

# Ungeprüfte Rezepte (Teststatus ≠ „Freigegeben“) auf einer Vorschau-Instanz zeigen.
# Auf der öffentlichen Website immer false lassen.
NEXT_PUBLIC_SHOW_DRAFTS=false

# Suchmaschinen erst nach Launch zulassen.
SITE_INDEXABLE=false

# ---------- Shopify (einzige Quelle für Produkte, Varianten, Preise, Grundpreise, Bestand, Warenkorb, Bestellungen) ----------
# Shopify Admin → Einstellungen → Apps → „Headless“-Kanal installieren → Storefront API → privaten Zugriffstoken erzeugen.
# Nur serverseitig. Nie mit NEXT_PUBLIC_ beginnen.
SHOPIFY_STORE_DOMAIN=            # z. B. nimbaland-spices.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_API_VERSION=2026-07

# ---------- Newsletter mit Double-Opt-in ----------
# Kontakt + Einwilligung werden in Shopify gespeichert (Admin API, Berechtigungen read_customers + write_customers).
# Shopify verschickt die Bestätigungsmail nicht per API; deshalb sendet die Website sie über Resend (resend.com).
SHOPIFY_ADMIN_ACCESS_TOKEN=
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=           # z. B. Nimbo’s Kitchen <rezepte@deine-domain.de> (Domain in Resend verifizieren)
NEWSLETTER_SIGNING_SECRET=       # zufällige Zeichenkette, mind. 32 Zeichen (z. B. openssl rand -base64 48)
